filters:
  and:
    - file.path.startsWith("db/")
    - db == "member"
views:
  - type: table
    name: members
    order:
      - done
      - file.name
      - by
      - file.links
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 232
  - type: table
    name: draft
    filters:
      and:
        - status != "done"
    order:
      - done
      - file.name
      - by
    sort:
      - property: created
        direction: ASC
    columnSize:
      file.name: 242
